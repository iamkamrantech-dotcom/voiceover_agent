# ============================================================
#  Voiceover Agent — settings template
#  Copy this file to .env and edit. .env is gitignored.
# ============================================================

# ---------- Paths ----------
INPUT_VIDEO=input/video.mp4
SCRIPT_FILE=input/script.txt
# Winning reference (see CLAUDE.md 4b). A 10s clip from 29.8s-39.8s of the
# client's recording, chosen so its FIRST 6 SECONDS are clean continuous
# speech - that is the only part the standard model's speaker encoder reads.
VOICE_SAMPLE=input/ref6_3.wav
# Full client recording - used as the target when scoring voice similarity.
VOICE_TARGET=input/voice_sample.mp3
OUTPUT_DIR=outputs
WORK_DIR=outputs/_work
KEEP_TEMP=false

# ---------- Hardware ----------
# This machine has no NVIDIA GPU -> cpu
DEVICE=cpu
NUM_THREADS=8

# ---------- External tools ----------
# Leave empty to auto-detect: PATH first, then the winget FFmpeg install.
FFMPEG_BIN=
FFPROBE_BIN=

# ---------- Chatterbox TTS (voice cloning) ----------
# WINNING SETUP, measured 2026-11-05 (tools/voice_experiment*.py):
#   standard + ref6_3.wav + exaggeration 0.5 + cfg_weight 0.5
#   best observed clip 85.1%; best-of-3 averages ~81%.
# "turbo" is ~3.5x faster but scored 73.1% - noticeably less like the client.
# "mock" is a fake tone generator for fast pipeline tests; never for output.
# standard | turbo | mock
TTS_ENGINE=standard
# Exaggeration / emotion intensity: 0.0 - 1.0 (0.5 = neutral)
# IGNORED by the turbo engine.
TTS_EXAGGERATION=0.5
# Classifier-free guidance weight: lower = slower, calmer delivery
# IGNORED by the turbo engine.
TTS_CFG_WEIGHT=0.5
TTS_TEMPERATURE=0.8
# Base seed. Take i of best-of-N uses TTS_SEED + i, so runs stay reproducible.
TTS_SEED=1234
# Cache synthesised audio so re-runs skip unchanged lines
TTS_CACHE=true
TTS_CACHE_DIR=outputs/_tts_cache

# ---------- Best-of-N (the biggest PROVEN quality lever) ----------
# Sampling is random: identical text + reference scored 73.8% - 82.2% across
# 4 seeds (8.4 points of spread). Generate N takes, keep the highest ECAPA
# score. Measured expected value:
#   N=1  77.4%   baseline
#   N=2  79.6%   +2.2 points, +70s per line
#   N=3  81.0%   +3.6 points, +141s per line
#   N=4  82.2%   +4.8 points, +211s per line
# Choosing the winner is cheap (ECAPA ~1s); cost is purely N x synthesis.
TTS_BEST_OF_N=3
# Drafts and tests use this instead, so iteration stays fast.
TTS_BEST_OF_N_DRAFT=1
# If no take in a block has the right words, regenerate it with fresh seeds
# this many extra times before giving up and keeping the closest one.
TTS_RETRY_ROUNDS=2

# ---------- Chunking and joining (agent/voice/chatterbox_synth.py) ----------
# Chatterbox degrades on long input, so a block is split into pieces no
# longer than this and the pieces are joined with a natural pause.
TTS_MAX_CHUNK_CHARS=250
# Pause inserted after a piece ending in . ! ?
TTS_PAUSE_SENTENCE=0.30
# Pause inserted after a piece ending in , ; :
TTS_PAUSE_COMMA=0.15
# Silence trimming at the block's start/end only (librosa top_db).
# Pauses INSIDE a block are deliberate and are never trimmed.
TTS_TRIM_TOP_DB=40

# ---------- Script splitting (agent/script_parser.py) ----------
# English narration pace. Used to balance the time-based split and to warn
# when the script simply cannot fit the video.
NARRATION_WPS=2.5
# Warn once the script needs more than this multiple of the video's length.
SCRIPT_OVERFLOW_RATIO=1.10

# ---------- Voice converter slot (optional second stage) ----------
# Runs AFTER the synthesizer and only changes the voice. See CLAUDE.md 4c.
# none | chatterbox_vc | rvc (planned)
# chatterbox_vc measured +0.1% similarity for +35s per clip -> not worth it.
VOICE_CONVERTER=none

# ---------- Voice similarity QC (tools/voice_similarity.py) ----------
# SpeechBrain ECAPA, scored against VOICE_TARGET. Reference points:
#   ~90%  two clips of the same speaker from different parts of a recording
#   ~85%  best single clone achieved so far
#   ~73%  turbo clone
# Blocks scoring below this get flagged for the user to listen to.
MIN_SIMILARITY=70
# ECAPA needs a few seconds of audio before its score means anything.
# Measured on ONE fixed clip, truncated: 1.0s -> 50%, 1.8s -> 71%,
# 2.5s -> 69%, 3.5s -> 79%, 5.0s -> 85%. Same voice throughout - the score
# tracks DURATION, not quality. So below this length the similarity is
# still recorded, but never used as a pass/fail gate.
MIN_SIMILARITY_SECONDS=3.5

# ---------- faster-whisper (timings / subtitles / QC) ----------
# tiny | base | small | medium | large-v3  (CPU here -> base or small)
WHISPER_MODEL=base
WHISPER_COMPUTE_TYPE=int8
WHISPER_LANGUAGE=en
WHISPER_BEAM_SIZE=5

# ---------- Scene detection (agent/scenes.py) ----------
# Combined distance above this starts a candidate transition (0.0 - 1.0).
SCENE_THRESHOLD=0.35
# Scenes shorter than this get merged into the neighbour (seconds).
MIN_SCENE_SECONDS=1.0
# Coarse pass sampling rate. ~10 fps is plenty to spot a transition.
SCENE_SAMPLE_FPS=10
# Each sampled frame is compared with one this far BACK, not its neighbour.
# Frame-to-frame difference cannot see a slow crossfade; 0.5s can.
SCENE_LAG_SECONDS=0.5
# Weight of the colour-histogram distance vs the coarse pixel difference.
# Histogram is blind to zoom/pan (so Ken Burns does not fire); pixels catch
# cuts between images that share a palette. 0.6 favours the histogram.
SCENE_HIST_WEIGHT=0.6
# Frames are reduced to this size before comparing - small enough that a
# slow zoom barely registers, big enough that a real cut is obvious.
SCENE_SMALL_WIDTH=32
SCENE_SMALL_HEIGHT=18
# A transition spanning this many frames or fewer is a hard cut, not a fade.
FADE_MIN_FRAMES=2

# ---------- Script to image matching ----------
# auto | markers | paragraphs | time
MATCH_MODE=auto
SCENE_MARKER_PATTERN=^\s*Scene\s*(\d+)\s*[:\-]

# ---------- Timing / fit rules (agent/align.py) ----------
# Breath before the voice starts inside a block.
LEAD_IN=0.25
# Air after the voice ends, and a bit more on the very last block.
TAIL_OUT=0.35
TAIL_OUT_FINAL=0.60
# Minimum silence between one block's voice ending and the next starting.
BLOCK_GAP=0.35
# QC fails if narration drifts more than this from intended timing (seconds)
MAX_DRIFT=0.40
MIN_SPEED=0.92
MAX_SPEED=1.12

# When a block's voice is too long, three fixes in order, cheapest first:
#  (a) tighten the pauses inside the block - free, nobody hears it
# Only pauses longer than this are touched...
PAUSE_TIGHTEN_ABOVE=0.25
# ...and never shortened below these floors, so the rhythm survives.
PAUSE_FLOOR_SENTENCE=0.18
PAUSE_FLOOR_COMMA=0.10
#  (b) speed the voice up, pitch preserved. Above ~8% it starts to sound
#      rushed, so this is the ceiling.
MAX_SPEEDUP=1.08
# auto picks rubberband when this FFmpeg build has it (better on speech),
# otherwise atempo. Force one with: rubberband | atempo
AUDIO_STRETCH_FILTER=auto
#  (c) extend the video: slow the part up to hold_end by at most this,
#      then freeze on the hold_end frame - never on a blended fade frame.
MAX_VIDEO_SLOWDOWN=1.15

# ---------- Preview render (agent/preview.py) ----------
# Fast and small on purpose: this is for checking sync by eye.
PREVIEW_HEIGHT=480
PREVIEW_CRF=28
PREVIEW_PRESET=veryfast
PREVIEW_SUBTITLES=true

# ---------- Audio ----------
# YouTube target loudness (EBU R128)
TARGET_LUFS=-14
TARGET_TRUE_PEAK=-1.5
AUDIO_SAMPLE_RATE=44100

# ---------- Subtitles ----------
MAKE_SUBTITLES=true
SUBTITLE_FORMAT=srt
SUBTITLE_MAX_CHARS=42
SUBTITLE_MAX_LINES=2
BURN_IN_SUBTITLES=false

# ---------- Render ----------
VIDEO_CODEC=libx264
VIDEO_CRF=18
VIDEO_PRESET=medium
AUDIO_CODEC=aac
AUDIO_BITRATE=192k

# ---------- Logging ----------
# Roman Urdu messages for the user, English detail in the per-run log file.
LOG_LEVEL=INFO
# One log file per run is written into this directory.
LOG_DIR=outputs/logs

# ---------- Testing ----------
# Use tiny clips so tests finish fast on CPU
FAST_TEST=true

# ---------- Web app (later phase) ----------
API_HOST=127.0.0.1
API_PORT=8000
